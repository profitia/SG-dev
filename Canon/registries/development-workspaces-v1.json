{
  "schemaVersion": "1.0",
  "repository": "profitia/SG-dev",
  "authorityBranch": "main",
  "phrRepository": "profitia/project-history-repository",
  "targetEnvironment": "development",
  "workspaces": [
    {
      "projectKey": "SG2",
      "directoryName": "sg2",
      "workspaceName": "SG-dev",
      "devcontainer": ".devcontainer/sg2/devcontainer.json",
      "packages": [
        "apps/pmos",
        "apps/sg-runtime",
        "apps/dashboard-preview"
      ],
      "ports": {
        "pmos": 3201,
        "runtime": 3001,
        "dashboard": 3002
      }
    },
    {
      "projectKey": "SRM",
      "directoryName": "srm",
      "workspaceName": "SG-dev Codespaces SRM",
      "devcontainer": ".devcontainer/srm/devcontainer.json",
      "packages": [
        "apps/pmos",
        "apps/srm"
      ],
      "ports": {
        "pmos": 3202,
        "runtime": 3400
      }
    },
    {
      "projectKey": "ARCHITECTURE",
      "directoryName": "architecture",
      "workspaceName": "SG-dev Architecture",
      "devcontainer": ".devcontainer/architecture/devcontainer.json",
      "packages": [
        "apps/pmos",
        "packages/platform-contracts",
        "apps/architecture-lab"
      ],
      "ports": {
        "pmos": 3203,
        "lab": 3500
      }
    }
  ]
}
