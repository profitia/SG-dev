+export function calendarPkProtectedReviewDigest(){return createHash('sha256').update(JSON.stringify(CALENDAR_PK_PROTECTED_REVIEW)).digest('hex')}
+export function assertCalendarPkProtectedSource(root,state,repositoryRoot=controlRoot()){
+ const r=CALENDAR_PK_PROTECTED_REVIEW
+ if(state?.admission?.kind!=='ARCHITECTURE'||!completeFunctionalMatches(state.admission.files,r))fail('CALENDAR_PK_PROTECTED_SOURCE_REJECTED')
+ assertPristineSourceInput(root,state.sha)
+ assertArchitectureCheckout(root,state.sha,state.admission,repositoryRoot)
+ return {protectedSourceReviewId:r.reviewId,protectedSourceReviewDigest:calendarPkProtectedReviewDigest(),originalSourceSha:r.sourceSha}
+}
+function calendarPkPackageUpgrade(name,current,accepted,file,authorityFile,review){
+ const r=CALENDAR_PK_PROTECTED_REVIEW
+ if(review!==r||name!=='@profitia/platform-source-hub-contracts'||current.version!=='1.8.0'||accepted.version!=='1.7.1')return false
+ for(const p of [file,authorityFile]){const a=fs.lstatSync(p);if(!a.isFile()||a.isSymbolicLink()||a.mode&0o111||fs.realpathSync(p)!==p)fail('CALENDAR_PK_PACKAGE_SOURCE_REJECTED')}
+ if(calendarBlob(fs.readFileSync(file))!==r.sourceHubAfterBlob||calendarBlob(fs.readFileSync(authorityFile))!==r.sourceHubBeforeBlob
+  ||JSON.stringify({...current,version:accepted.version})!==JSON.stringify(accepted))fail('CALENDAR_PK_PACKAGE_SOURCE_REJECTED')
+ return true
+}
+export function assertCalendarPkProtectedProof(proof,run,candidateSha,workflowId,{currentRunId,currentRef,completedJobs=[],expectedControlDigest=controlPolicyDigest()}={}){
+ const r=CALENDAR_PK_PROTECTED_REVIEW
+ const keys=['schemaVersion','repository','workflow','targetEnvironment','scope','candidateSha','controlSha','executionWorkspace','executionCheckoutSha','sourceInputVerifiedBeforeExecution','sourceInputVerifiedAfterExecution','protectedSourceReviewId','protectedSourceReviewDigest','originalSourceSha','controlPolicyDigest','runId','install','credentialRemovedBeforeCandidateExecution','privatePackageArtifactsPublished','tests','typecheck','build','productDeploymentPerformed','customerIdentityAdapterVerified']
+ if(calendarKeys(proof)!==JSON.stringify(keys.sort()))fail('VALIDATION_PROVENANCE_MISMATCH')
+ const sameRun=String(run.id)===String(currentRunId)&&currentRef==='refs/heads/main'&&run.event==='push'
+  &&completedJobs.some(j=>j.name==='SG2 controlled operation integration'&&j.conclusion==='success')
+ if(run.workflow_id!==workflowId||run.repository?.full_name!==REPOSITORY||run.head_branch!=='main'
+  ||!['push','workflow_dispatch'].includes(run.event)||run.actor?.login!=='profitia'||(!sameRun&&run.conclusion!=='success'))fail('UNTRUSTED_VALIDATION_RUN')
+ if(proof?.schemaVersion!=='2.0'||proof.scope!=='EXACT_PROTECTED_SOURCE_VALIDATION'||proof.repository!==REPOSITORY
+  ||proof.targetEnvironment!=='development'||proof.workflow!==WORKFLOW||!shaPattern.test(candidateSha??'')||proof.candidateSha!==candidateSha
+  ||proof.originalSourceSha!==r.sourceSha||proof.controlSha!==run.head_sha||String(proof.runId)!==String(run.id)
+  ||proof.protectedSourceReviewId!==r.reviewId||proof.protectedSourceReviewDigest!==calendarPkProtectedReviewDigest()
+  ||Object.hasOwn(proof,'sourceAdmissionId')||Object.hasOwn(proof,'sourceAdmissionDigest')||Object.hasOwn(proof,'contract')
+  ||!shaPattern.test(proof.controlSha??''))fail('VALIDATION_PROVENANCE_MISMATCH')
+ if(proof.controlPolicyDigest!==expectedControlDigest)fail('CONTROL_POLICY_PROVENANCE_MISMATCH')
