+import {completeFunctionalPredecessor,COMPLETE_FUNCTIONAL_PRODUCER_RECORD,COMPLETE_FUNCTIONAL_CONSUMER_RECORD,CALENDAR_CI_REPAIR_PATHS,CALENDAR_CI_REPAIR_BASE} from '../ecr-complete-functional-source.mjs'
