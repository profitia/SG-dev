+  assert.equal((await f.api('notifications',{method:'PUT',body:{expectedVersion:0,settings:{emailEnabled:true,timeZone:'Europe/Warsaw'}}})).status,200)
+  await persist(f,await response('petroleum/stoc/wstk'))
