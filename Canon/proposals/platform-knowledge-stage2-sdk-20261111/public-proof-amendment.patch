+    encoded=(await readApi(`repos/${REPOSITORY}/git/blobs/${metadata.sha}`)).data
+    if(encoded?.sha!==metadata.sha||encoded.size!==metadata.size)fail('CONTROL_POLICY_CONTENT_MISMATCH')
+  }
