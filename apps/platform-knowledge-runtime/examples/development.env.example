# Nonsecret template. Set DATABASE_URL in each service directly, never in Git.
# Node 24.15.0 is pinned by digest in Dockerfile.
NODE_ENV=production
PK_ENVIRONMENT=development
PK_PROCESSING_ENABLED=false
PK_NEON_PROJECT_ID=sparkling-sky-79692560
PK_NEON_BRANCH_ID=br-billowing-grass-b9ko5s4f
PK_DATABASE_HOST=ep-wild-mode-b972j8k0-pooler.c-7.eu-central-1.aws.neon.tech
# DATABASE_URL: limited API or worker login, platform_knowledge, sslmode=require.
# RENDER_GIT_COMMIT is injected by Render. Local tests use PK_RELEASE_SHA.
# SENTRY_DSN and PK_SENTRY_PROJECT: only the accepted Platform Knowledge project.
# No OPENAI_API_KEY or S3 credential required by the FOUNDATION_ONLY bootstrap.

# Stage 2 activation additions (only after exact source/migration/admission gates):
# Set existing DATABASE_URL sslmode=verify-full, retaining its corresponding role.
# PK_PROCESSING_ENABLED=true
# OPENAI_API_KEY: reuse the approved existing secret; no GitHub CI key.
# PK_S3_ENDPOINT=https://br-billowing-grass-b9ko5s4f.storage.c-7.eu-central-1.aws.neon.tech
# PK_S3_BUCKET=platform-knowledge-uploads
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: each existing role's read-write key.
PK_OPENAI_STARTUP_BUDGET_USD=10
PK_OPENAI_DOCUMENT_LIMIT_USD=1
# PK_CLERK_PUBLISHABLE_KEY: the existing Development pk_test_ public key, API only.
# PK_E1_WORKER_KEY_ID and PK_E1_WORKER_PRIVATE_KEY: owner-enrolled Ed25519 key,
# Worker only; public counterpart belongs in the existing central E1 receiver.
