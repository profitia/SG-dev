{
  "name": "@sg/runtime",
  "version": "0.1.0",
  "private": true,
  "description": "SpendGuru 2.0 — Application Runtime",
  "scripts": {
    "dev": "next dev --port 3001",
    "postinstall": "prisma generate && prisma generate --schema prisma-market-data/schema.prisma",
    "build": "prisma generate && prisma generate --schema prisma-market-data/schema.prisma && next build",
    "start": "next start -p ${PORT:-3001}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:runtime-build-contract": "node --test tests/runtime-build-contract.test.mjs",
    "test:market-data": "node --import tsx --test tests/market-data-service.test.ts",
    "test:forecast-library": "node --import tsx --test tests/forecast-library-service.test.ts",
    "test:forecast-live-input": "node --import tsx --test tests/forecast-live-input.test.ts",
    "forecast:operations": "node --import tsx scripts/run-forecast-production-operations.ts",
    "forecast:operations:rolling-daily": "node --import tsx scripts/run-rolling-daily-production-operations.ts",
    "forecast:snapshot:rolling-daily": "node --import tsx scripts/persist-rolling-daily-current-forecast-snapshot.ts",
    "market-data:generate": "prisma generate --schema prisma-market-data/schema.prisma",
    "market-data:migrate": "prisma migrate dev --schema prisma-market-data/schema.prisma",
    "market-data:migrate:deploy": "prisma migrate deploy --schema prisma-market-data/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "14.2.29",
    "next-intl": "^3.26.5",
    "openai": "^6.38.0",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3"
  }
}
