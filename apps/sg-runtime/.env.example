# Opt-in source candidate. Configuration alone does not provision SQL, roles,
# grants, capacity or a release. Existing workers keep their current mode.
PROFITIA_FORECAST_WORKER_ENABLED=false
# Only enable after the controlled Development initialization and release.
# PROFITIA_FORECAST_WORKER_CONFIGURATION_VERSION=sg2-native-forecast-worker-dev-v2
# Save the role-specific TLS URL as a Render secret, never in this file.
# PROFITIA_FORECAST_WORKER_DATABASE_URL=

# Source candidate only. No setting below provisions roles or activates a service.
# Private HUMAN request runtime: requires PROFITIA_FORECAST_REQUEST_ENABLED=true.
# Existing native Current worker: requires the separately accepted native worker
# binding plus the official Clerk Development configuration. Never Verification.
# PROFITIA_FORECAST_DISPATCH_ENABLED=false
# PROFITIA_FORECAST_DISPATCH_CONFIGURATION_VERSION=sg2-private-forecast-dispatch-dev-v1
# PROFITIA_FORECAST_DISPATCH_DATABASE_URL=<ordinary private dispatch login; secret>
# PROFITIA_FORECAST_QUEUE_DATABASE_URL=<ordinary shared source admission login; secret>
