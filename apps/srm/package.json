{
  "name": "srm-app",
  "version": "0.1.0",
  "private": true,
  "description": "SRM AppShell and AppShield presentation skin",
  "scripts": {
    "dev": "next dev --port 3400",
    "build": "next build",
    "postbuild": "mkdir -p .next/standalone/public && cp -R public/. .next/standalone/public/",
    "start": "next start --port 3400",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/server/*.test.ts",
    "migrate:development": "node scripts/migrate.mjs",
    "test:promotion": "node --test --test-concurrency=1 scripts/promotion.test.mjs scripts/staging-lifecycle.test.mjs",
    "promote:staging": "node scripts/promote-staging.mjs",
    "migrate:staging:plan": "node scripts/staging-migrate.mjs --plan"
  },
  "dependencies": {
    "@profitia/srm-xray": "file:../../packages/srm-xray",
    "exceljs": "^4.4.0",
    "next": "16.3.8",
    "pdfkit": "0.20.2",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
