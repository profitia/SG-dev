# PCOS Cognition Explorer — environment configuration
# Read-only connection to the PCOS LAB database (Neon PostgreSQL)
# Copy to .env.local and fill in your values.

# -------------------------------------------------------------------
# LIVE MODE ONLY: PCOS-owned LAB database (Neon pooled + direct)
# Never use a PMOS endpoint or PMOS database here.
# Mock preview deployments must leave both values unset.
# -------------------------------------------------------------------
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# -------------------------------------------------------------------
# Org context
# Set to the orgId used during PCOS hydration (e.g. "pcos-default")
# -------------------------------------------------------------------
PCOS_EXPLORER_ORG_ID="pcos-default"

# -------------------------------------------------------------------
# Environment label shown in the header
# LAB | PROD | SANDBOX
# -------------------------------------------------------------------
PCOS_EXPLORER_ENV="LAB"

# -------------------------------------------------------------------
# Preview mode
# live -> use Prisma-backed cognition routes
# mock -> keep the root shell and dataset preview routes safe without DB access
# -------------------------------------------------------------------
PCOS_EXPLORER_PREVIEW_MODE="live"
