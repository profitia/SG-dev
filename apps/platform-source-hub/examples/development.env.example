# Non-secret values only. Load actual secrets from an owner-controlled store.
NODE_VERSION=24.15.0
SOURCE_HUB_ENVIRONMENT=development
SOURCE_HUB_DEPLOYMENT_ID=source-hub-stage2a-v1
SOURCE_HUB_CONFIGURATION_VERSION=source-hub-stage2a-v1
# OPTIONAL LEGACY GROUP: set all three only for the existing Newsfeed path.
# SOURCE_HUB_PEER_KEY_ID: retain the accepted existing value.
PROFITIA_REQUIRED_PRODUCT=SPENDGURU
# PORT: supplied by Render. Local examples must avoid reserved ports.
# SOURCE_HUB_PUBLIC_ORIGIN: actual owner-created Hub HTTPS origin.
# NEWSFEED_PUBLIC_ORIGIN: actual owner-created Newsfeed HTTPS origin.
# PROFITIA_IDENTITY_ISSUER: accepted canonical Development issuer.
# PROFITIA_AUTHORIZED_PARTIES: comma-separated exact accepted origins.
# CLERK_PUBLISHABLE_KEY: accepted Development pk_test_ public key.
# SECRET SOURCE_HUB_DATABASE_URL: pooled source_hub_development_runtime.
# SECRET SOURCE_HUB_SOURCE_DATABASE_URL: pooled source_hub_development_source_runtime.
# SECRET CLERK_SECRET_KEY: accepted Development sk_test_ credential.
# SECRET SOURCE_HUB_PEER_KEY_B64: legacy Newsfeed pair only, never all components.
# SECRET SOURCE_HUB_DEVELOPMENT_NEWSAPI_API_KEY
# SECRET SOURCE_HUB_DEVELOPMENT_BRAVE_API_KEY
# SECRET SOURCE_HUB_DEVELOPMENT_TRADING_ECONOMICS_API_KEY
# MIGRATOR ONLY, outside Render: SOURCE_HUB_MIGRATOR_DATABASE_URL.

# Generic first-party trust comes from current central E1, not a module allowlist.
# New component private keys remain only in each component's secret store.
# MIGRATOR ONLY: SOURCE_HUB_INSTALL_FIRST_PARTY=true installs additive004.
