# Vercly - local PostgreSQL / Prisma configuration
# Copy to .env for local development.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/vercly?sslmode=require"

# Optional direct connection placeholder for future migration workflows.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/vercly?sslmode=require"

# Vercly provider adapter configuration
VERCLY_API_BASE_URL="https://demo.vercly.it"
VERCLY_API_USERNAME=""
VERCLY_API_PASSWORD=""
VERCLY_POLL_INTERVAL_MS="3000"
VERCLY_POLL_TIMEOUT_MS="60000"
VERCLY_DEFAULT_COUNTRY="PL"