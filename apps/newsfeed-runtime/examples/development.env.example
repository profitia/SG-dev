# Non-secret values only. Provider credentials belong exclusively to Source Hub.
NODE_VERSION=24.15.0
NEWSFEED_ENVIRONMENT=development
NEWSFEED_DEPLOYMENT_ID=newsfeed-stage2a-v1
NEWSFEED_CONFIGURATION_VERSION=newsfeed-stage2a-v1
SOURCE_HUB_PEER_KEY_ID=newsfeed-source-hub-development-v1
PROFITIA_REQUIRED_PRODUCT=SPENDGURU
# PORT: supplied by Render.
# NEWSFEED_PUBLIC_ORIGIN: actual owner-created Newsfeed HTTPS origin.
# SOURCE_HUB_PUBLIC_ORIGIN: actual owner-created Hub HTTPS origin.
# PROFITIA_IDENTITY_ISSUER: accepted canonical Development issuer.
# PROFITIA_AUTHORIZED_PARTIES: exact origins including the Newsfeed API.
# CLERK_PUBLISHABLE_KEY: accepted Development pk_test_ public key.
# SECRET NEWSFEED_DATABASE_URL: pooled newsfeed_development_runtime.
# SECRET CLERK_SECRET_KEY: accepted Development sk_test_ credential.
# SECRET SOURCE_HUB_PEER_KEY_B64: same accepted peer secret as Hub.
# MIGRATOR ONLY, outside Render: NEWSFEED_MIGRATOR_DATABASE_URL.
