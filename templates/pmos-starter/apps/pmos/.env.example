# Environment Variables — PMOS
# Copy to .env.local and fill in values

# ─── PostgreSQL (required) ────────────────────────────────────────────────────
# Neon Postgres recommended: https://neon.tech (free tier available)
#
# DATABASE_URL — use the POOLED connection string from Neon dashboard
# (Connection Pooler → Pooled connection → copy the string)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/pmos?sslmode=require"

# DIRECT_URL — use the DIRECT (non-pooled) connection string from Neon dashboard
# (Connection Details → Direct connection → copy the string)
# Required for Prisma Migrate and schema operations.
# Using the same value as DATABASE_URL for DIRECT_URL may cause DDL failures.
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/pmos?sslmode=require"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3200"

# ─── Optional ─────────────────────────────────────────────────────────────────
# Add any project-specific environment variables below
