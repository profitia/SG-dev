{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forecast-phase-2-stress-test-result-v1",
  "title": "Forecast Phase 2.1 Stress-Test Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion", "stressRunId", "scenarioId", "environmentId", "sourceRevision", "startedAt", "endedAt",
    "concurrency", "keyDistribution", "loadShape", "releaseSpreadMs", "benchmark", "datasetFingerprint", "modelId",
    "requestsStarted", "requestsCompleted", "successCount", "failureCount", "errorRate", "functionalOutcomes",
    "latencyMinMs", "latencyP50Ms", "latencyP90Ms", "latencyP95Ms", "latencyP99Ms", "latencyMaxMs", "latencyMeanMs",
    "throughputRps", "successfulThroughputRps", "cpuSeconds", "peakMemoryMb", "memoryDeltaAfterCooldownMb",
    "dbQueryCount", "dbWriteCount", "providerCallCount", "forecastComputeCount", "verificationComputeCount",
    "computeOwnerCount", "duplicateComputeCount", "duplicateComputeRatio", "duplicateArtifactWriteCount",
    "preparedHitCount", "preparedMissCount", "wallClockSeconds", "classification", "bottleneckAttribution",
    "firstRunAfterStateSetup", "repetitionNumber", "excluded", "exclusionReason", "correctnessPassed", "notes"
  ],
  "properties": {
    "contractVersion": { "const": 1 },
    "stressRunId": { "type": "string", "minLength": 1 },
    "scenarioId": { "type": "string", "pattern": "^(P(0[1-9]|1[01])|E0[1-3])$" },
    "environmentId": { "type": "string", "minLength": 1 },
    "sourceRevision": { "type": "string", "minLength": 7 },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" },
    "concurrency": { "enum": [10, 100, 1000] },
    "keyDistribution": { "enum": ["SAME_KEY", "SMALL_POOL", "DISTRIBUTED_KEYS"] },
    "loadShape": { "enum": ["SYNCHRONIZED_BURST", "CONTROLLED_STEADY_FLOW"] },
    "releaseSpreadMs": { "type": "number", "minimum": 0 },
    "benchmark": { "type": "string", "minLength": 1 },
    "datasetFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seriesId", "frequency", "lawfulObservationCount", "historyStart", "historyEnd", "historyFingerprint", "targetSemantics", "horizon"],
      "properties": {
        "seriesId": { "type": "string" },
        "frequency": { "type": "string" },
        "lawfulObservationCount": { "type": "integer", "minimum": 0 },
        "historyStart": { "type": "string", "format": "date-time" },
        "historyEnd": { "type": "string", "format": "date-time" },
        "historyFingerprint": { "type": "string", "minLength": 1 },
        "targetSemantics": { "type": "string" },
        "horizon": { "type": "string" }
      }
    },
    "modelId": { "enum": ["naive", "damped_holt", "ets", "arima", "mixed"] },
    "requestsStarted": { "type": "integer", "minimum": 0 },
    "requestsCompleted": { "type": "integer", "minimum": 0 },
    "successCount": { "type": "integer", "minimum": 0 },
    "failureCount": { "type": "integer", "minimum": 0 },
    "errorRate": { "type": "number", "minimum": 0, "maximum": 1 },
    "functionalOutcomes": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "latencyMinMs": { "$ref": "#/$defs/nullableNonNegativeNumber" },
    "latencyP50Ms": { "$ref": "#/$defs/nullableNonNegativeNumber" },
    "latencyP90Ms": { "$ref": "#/$defs/nullableNonNegativeNumber" },
    "latencyP95Ms": { "$ref": "#/$defs/nullableNonNegativeNumber" },
    "latencyP99Ms": { "$ref": "#/$defs/nullableNonNegativeNumber" },
    "latencyMaxMs": { "$ref": "#/$defs/nullableNonNegativeNumber" },
    "latencyMeanMs": { "$ref": "#/$defs/nullableNonNegativeNumber" },
    "throughputRps": { "$ref": "#/$defs/nullableNonNegativeNumber" },
    "successfulThroughputRps": { "$ref": "#/$defs/nullableNonNegativeNumber" },
    "cpuSeconds": { "$ref": "#/$defs/nullableNonNegativeNumber" },
    "peakMemoryMb": { "$ref": "#/$defs/nullableNonNegativeNumber" },
    "memoryDeltaAfterCooldownMb": { "type": ["number", "null"] },
    "dbQueryCount": { "$ref": "#/$defs/nullableNonNegativeInteger" },
    "dbWriteCount": { "$ref": "#/$defs/nullableNonNegativeInteger" },
    "providerCallCount": { "$ref": "#/$defs/nullableNonNegativeInteger" },
    "forecastComputeCount": { "$ref": "#/$defs/nullableNonNegativeInteger" },
    "verificationComputeCount": { "$ref": "#/$defs/nullableNonNegativeInteger" },
    "computeOwnerCount": { "$ref": "#/$defs/nullableNonNegativeInteger" },
    "duplicateComputeCount": { "$ref": "#/$defs/nullableNonNegativeInteger" },
    "duplicateComputeRatio": { "$ref": "#/$defs/nullableNonNegativeNumber" },
    "duplicateArtifactWriteCount": { "$ref": "#/$defs/nullableNonNegativeInteger" },
    "preparedHitCount": { "$ref": "#/$defs/nullableNonNegativeInteger" },
    "preparedMissCount": { "$ref": "#/$defs/nullableNonNegativeInteger" },
    "wallClockSeconds": { "type": "number", "minimum": 0 },
    "classification": { "enum": ["HEALTHY", "DEGRADED", "SATURATED", "STRUCTURAL_DUPLICATION", "RESOURCE_EXHAUSTED", "PROVIDER_BOUND", "DATABASE_BOUND", "COMPUTE_BOUND", "UNKNOWN_BOUND", "NOT_CLASSIFIED"] },
    "bottleneckAttribution": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "firstRunAfterStateSetup": { "type": "boolean" },
    "repetitionNumber": { "type": "integer", "minimum": 1 },
    "excluded": { "type": "boolean" },
    "exclusionReason": { "enum": ["HARNESS_FAILURE", "ENVIRONMENT_OUTAGE", "PROVIDER_OUTAGE", "INVALID_STATE_SETUP", "NOT_EXCLUDED"] },
    "correctnessPassed": { "type": "boolean" },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "nullableNonNegativeNumber": { "type": ["number", "null"], "minimum": 0 },
    "nullableNonNegativeInteger": { "type": ["integer", "null"], "minimum": 0 }
  }
}