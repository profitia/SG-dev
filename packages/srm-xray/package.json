{
  "name": "@profitia/srm-xray",
  "version": "0.4.0",
  "private": true,
  "description": "Reusable SRM X-Ray section mounts and host contract",
  "type": "module",
  "exports": {
    "./supplier-search.css": "./src/supplier-search.css",
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./financial-scanner.css": "./src/financial-scanner.css",
    "./msr-financial-tables.css": "./src/msr-financial-tables.css",
    "./contracts": {
      "types": "./src/contracts.ts",
      "default": "./src/contracts.ts"
    },
    "./financial-value": {
      "types": "./src/financial-value.ts",
      "default": "./src/financial-value.ts"
    },
    "./executive-summary-rules": {
      "types": "./src/executive-summary-rules.ts",
      "default": "./src/executive-summary-rules.ts"
    },
    "./executive-summary": {
      "types": "./src/executive-summary.tsx",
      "default": "./src/executive-summary.tsx"
    },
    "./shared-financial-summary": {
      "types": "./src/shared-financial-summary.ts",
      "default": "./src/shared-financial-summary.ts"
    },
    "./workflow": {
      "types": "./src/workflow.ts",
      "default": "./src/workflow.ts"
    },
    "./workflow-contract": {
      "types": "./src/workflow-contract.ts",
      "default": "./src/workflow-contract.ts"
    },
    "./workflow.css": "./src/workflow.css",
    "./workflow-controller": {
      "types": "./src/workflow-controller.ts",
      "default": "./src/workflow-controller.ts"
    },
    "./full-report": {
      "types": "./src/full-report.tsx",
      "default": "./src/full-report.tsx"
    },
    "./full-report.css": "./src/full-report.css",
    "./full-workflow": {
      "types": "./src/full-workflow.tsx",
      "default": "./src/full-workflow.tsx"
    },
    "./full-report-operations": {
      "types": "./src/full-report-operations.ts",
      "default": "./src/full-report-operations.ts"
    },
    "./supplier-search-gateway": {
      "types": "./src/supplier-search-gateway.ts",
      "default": "./src/supplier-search-gateway.ts"
    },
    "./supplier-location-controller": {
      "types": "./src/supplier-location-controller.ts",
      "default": "./src/supplier-location-controller.ts"
    },
    "./supplier-map-readiness": {
      "types": "./src/supplier-map-readiness.ts",
      "default": "./src/supplier-map-readiness.ts"
    },
    "./supplier-map-startup": {
      "types": "./src/supplier-map-startup.ts",
      "default": "./src/supplier-map-startup.ts"
    },
    "./supplier-web-request": {
      "types": "./src/supplier-web-request.ts",
      "default": "./src/supplier-web-request.ts"
    }
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.2.4"
  },
  "scripts": {
    "build:presentation-css": "node scripts/build-full-report-css.mjs",
    "check:presentation-css": "node scripts/build-full-report-css.mjs --check"
  }
}
