{
  "name": "@profitia/platform-current-e1-authority",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "Optional current central E1 admission and outcome contract; canonical SDK unchanged",
  "files": [
    "index.mjs",
    "index.d.mts",
    "first-party.mjs",
    "first-party.d.mts",
    "migrations",
    "insights-service.mjs"
  ],
  "exports": {
    "./first-party": {
      "types": "./first-party.d.mts",
      "import": "./first-party.mjs"
