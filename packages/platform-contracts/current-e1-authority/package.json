    ".": {
      "types": "./index.d.mts",
      "import": "./index.mjs",
      "require": "./index.mjs"
    },
    "./insights-service": "./insights-service.mjs"
  },
  "scripts": {
    "build": "node --check index.mjs"
  },
  "peerDependencies": {
    "@profitia/platform-contracts": "1.33.0 || 1.34.0"
  },
  "devDependencies": {
    "@profitia/platform-contracts": "file:.."
  }
}
